{
  "name": "beaufort-learning-harbor-v11",
  "version": "11.0.0-rc.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "check:boundaries": "node scripts/check-boundaries-rc1.mjs",
    "check:deploy-readiness": "node scripts/check-deploy-readiness.mjs",
    "check:vite-deploy-output": "node scripts/check-vite-deploy-output.mjs",
    "check:hosted-pilot-core": "node scripts/check-hosted-pilot-core.mjs",
    "check:hosted-browser-resilience": "node scripts/check-hosted-browser-resilience.mjs",
    "check:hosted-multi-account-authorization": "node scripts/check-hosted-multi-account-authorization.mjs",
    "migration:rehearse": "node scripts/migration-rehearsal.mjs",
    "readiness:report": "node scripts/production-readiness.mjs",
    "vendor-exit:verify": "node scripts/vendor-exit-rehearsal.mjs",
    "rc2:evidence:repository": "node scripts/rc2-evidence.mjs repository",
    "rc2:evidence:provider": "node scripts/rc2-evidence.mjs provider",
    "pilot:doctor": "node scripts/pilot-doctor.mjs",
    "pilot:doctor:browser": "node scripts/pilot-doctor.mjs browser",
    "pilot:verify-schema": "node scripts/verify-remote-schema.mjs",
    "pilot:run-core": "node scripts/run-hosted-pilot-core.mjs",
    "pilot:validate-core": "node scripts/validate-hosted-pilot-core.mjs",
    "pilot:test-browser-resilience": "playwright test --config=playwright.hosted.config.ts",
    "pilot:validate-browser-resilience": "node scripts/validate-hosted-browser-resilience.mjs",
    "pilot:test-multi-account-authorization": "playwright test hosted-tests/hosted-multi-account-authorization.spec.ts --config=playwright.hosted.config.ts",
    "pilot:validate-multi-account-authorization": "node scripts/validate-hosted-multi-account-authorization.mjs",
    "verify": "npm run typecheck && npm run check:boundaries && npm run check:hosted-pilot-core && npm run check:hosted-browser-resilience && npm run check:hosted-multi-account-authorization && npm run migration:rehearse && npm run readiness:report && npm run vendor-exit:verify && npm run rc2:evidence:repository && npm run build && npm run check:vite-deploy-output",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:stop": "supabase stop --no-backup",
    "deploy:preview": "npm run verify && npm run check:deploy-readiness && wrangler deploy"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.47.0",
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "supabase": "2.110.0",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "wrangler": "4.114.0"
  }
}
