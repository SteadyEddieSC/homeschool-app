{
  "name": "beaufort-learning-harbor",
  "version": "10.43.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:foundation": "node scripts/check-foundation.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check:privacy": "node scripts/check-privacy.mjs && node scripts/check-v10.39-privacy.mjs && node scripts/check-v10.39.1-privacy.mjs && node scripts/check-v10.40-privacy.mjs && node scripts/check-v10.41-privacy.mjs && node scripts/check-v10.42-privacy.mjs && node scripts/check-v10.43-privacy.mjs",
    "check:offline-runtime": "node scripts/check-offline-runtime.mjs",
    "check:console-stability": "node scripts/check-console-stability.mjs",
    "check:app-shell-role-policy": "node scripts/check-app-shell-role-policy.mjs",
    "check:learner-route-resolver": "node scripts/check-learner-route-resolver.mjs",
    "check:family-planner-v2": "node scripts/check-family-planner-v2.mjs",
    "check:lesson-pack-controlled-apply": "node scripts/check-lesson-pack-controlled-apply.mjs",
    "verify": "npm run check:foundation && npm run test:data-adapter && npm run test:knowledge-check && npm run test:lesson-pack && npm run test:lesson-pack-controlled-apply && npm run test:family-planner && npm run test:family-planner-v2 && npm run test:offline-runtime && npm run test:app-shell-role-policy && npm run test:learner-route-resolver",
    "verify:release": "npm run build && npm run check:release && npm run check:lesson-pack-controlled-apply && npm run check:offline-runtime && npm run check:console-stability && npm run check:app-shell-role-policy && npm run check:learner-route-resolver && npm run check:family-planner-v2 && npm run check:privacy",
    "serve": "node scripts/serve.mjs",
    "test": "playwright test",
    "test:data-adapter": "node --test tests/data-adapter.test.mjs tests/data-adapter-demo.test.mjs",
    "test:knowledge-check": "node --test tests/knowledge-check-bank.test.mjs",
    "test:lesson-pack": "node --test tests/lesson-pack.test.mjs",
    "test:lesson-pack-controlled-apply": "node --test tests/lesson-pack-controlled-apply.test.mjs",
    "test:family-planner": "node --test tests/family-planner.test.mjs",
    "test:family-planner-v2": "node --test tests/family-planner-v2.test.mjs",
    "test:offline-runtime": "node --test tests/offline-runtime.test.mjs",
    "test:app-shell-role-policy": "node --test tests/app-shell-role-policy.test.mjs",
    "test:learner-route-resolver": "node --test tests/learner-route-resolver.test.mjs",
    "test:knowledge-workflow": "playwright test tests/knowledge-check-builder.spec.mjs",
    "test:lesson-pack-workflow": "playwright test tests/lesson-pack-editor.spec.mjs tests/lesson-pack-controlled-apply.spec.mjs",
    "test:lesson-pack-apply-workflow": "playwright test tests/lesson-pack-controlled-apply.spec.mjs",
    "test:family-planner-workflow": "playwright test tests/family-planner.spec.mjs tests/family-planner-v2.spec.mjs",
    "test:offline-workflow": "playwright test tests/offline-runtime.spec.mjs",
    "test:console-stability": "playwright test tests/console-stability.spec.mjs",
    "test:app-shell-role-policy-workflow": "playwright test tests/app-shell-role-policy.spec.mjs",
    "test:learner-route-resolver-workflow": "playwright test tests/learner-route-resolver.spec.mjs",
    "test:visual-baseline": "playwright test tests/visual-baseline.spec.mjs --project=chromium-desktop",
    "test:data-workflow": "playwright test tests/data-workflow.spec.mjs",
    "test:smoke": "playwright test tests/smoke.spec.mjs",
    "test:mobile": "playwright test tests/mobile-dock.spec.mjs",
    "test:demo": "playwright test tests/demo-state.spec.mjs",
    "test:hero": "playwright test tests/hero-stability.spec.mjs",
    "test:routes": "playwright test tests/student-routes.spec.mjs",
    "test:roles": "playwright test tests/role-boundaries.spec.mjs",
    "test:destinations": "playwright test tests/destination-stability.spec.mjs --project=chromium-mobile",
    "test:a11y": "playwright test tests/accessibility.spec.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "pngjs": "7.0.0"
  }
}
